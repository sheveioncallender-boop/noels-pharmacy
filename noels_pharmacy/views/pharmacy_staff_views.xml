<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_staff_list" model="ir.ui.view">
        <field name="name">pharmacy.staff.profile.list</field>
        <field name="model">pharmacy.staff.profile</field>
        <field name="arch" type="xml">
            <list string="Pharmacy Staff">
                <field name="name"/>
                <field name="initials"/>
                <field name="role"/>
                <field name="license_number"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_staff_form" model="ir.ui.view">
        <field name="name">pharmacy.staff.profile.form</field>
        <field name="model">pharmacy.staff.profile</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Staff Profile">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title"><h1><field name="user_id"/></h1></div>
                    <group>
                        <group>
                            <field name="initials"/>
                            <field name="role"/>
                        </group>
                        <group>
                            <field name="license_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_staff" model="ir.actions.act_window">
        <field name="name">Pharmacy Staff</field>
        <field name="res_model">pharmacy.staff.profile</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

