<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_inspection_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.inspection.wizard.form</field>
        <field name="model">pharmacy.inspection.wizard</field>
        <field name="arch" type="xml">
            <form string="Inspection &amp; Audit Reports">
                <group>
                    <group>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                    <group>
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="register_type_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <div class="alert alert-info" role="alert">
                    The PDF creates an inspection pack. The ZIP contains separate CSV files for prescriptions, dispensing, Antibiotics, Controlled Drugs, Narcotics and immutable audit events.
                </div>
                <footer>
                    <button name="action_print_pdf" type="object" string="Inspection PDF" class="btn-primary"/>
                    <button name="action_export_csv_pack" type="object" string="Export CSV Pack" class="btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_pharmacy_inspection_wizard" model="ir.actions.act_window">
        <field name="name">Inspection &amp; Audit Reports</field>
        <field name="res_model">pharmacy.inspection.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_pharmacy_reporting" name="Reporting" parent="noels_pharmacy.menu_pharmacy_root" sequence="40" groups="noels_pharmacy.group_pharmacy_manager,noels_pharmacy.group_pharmacy_auditor"/>
    <menuitem id="menu_pharmacy_inspection_reports" name="Inspection &amp; Audit Reports" parent="menu_pharmacy_reporting" action="action_pharmacy_inspection_wizard" sequence="10"/>
</odoo>
