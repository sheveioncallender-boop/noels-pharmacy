<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_audit_log_search" model="ir.ui.view">
        <field name="name">pharmacy.audit.log.search</field>
        <field name="model">pharmacy.audit.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="record_name"/>
                <field name="model_name"/>
                <field name="user_id"/>
                <field name="event_datetime"/>
                <filter name="created" string="Created" domain="[('action', '=', 'create')]"/>
                <filter name="changed" string="Changed" domain="[('action', '=', 'write')]"/>
                <filter name="deleted" string="Deleted" domain="[('action', '=', 'unlink')]"/>
                <group>
                    <filter name="group_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="group_model" string="Record Type" context="{'group_by': 'model_name'}"/>
                    <filter name="group_date" string="Date" context="{'group_by': 'event_datetime:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pharmacy_audit_log_list" model="ir.ui.view">
        <field name="name">pharmacy.audit.log.list</field>
        <field name="model">pharmacy.audit.log</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="event_datetime"/>
                <field name="user_id"/>
                <field name="action"/>
                <field name="model_name"/>
                <field name="record_name"/>
                <field name="record_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_audit_log_form" model="ir.ui.view">
        <field name="name">pharmacy.audit.log.form</field>
        <field name="model">pharmacy.audit.log</field>
        <field name="arch" type="xml">
            <form string="Audit Event" create="0" edit="0" delete="0">
                <sheet>
                    <div class="oe_title"><h1><field name="record_name"/></h1></div>
                    <group>
                        <group>
                            <field name="event_datetime"/>
                            <field name="user_id"/>
                            <field name="action"/>
                        </group>
                        <group>
                            <field name="model_name"/>
                            <field name="record_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Before"><field name="old_values_text" nolabel="1"/></page>
                        <page string="After"><field name="new_values_text" nolabel="1"/></page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_audit_log" model="ir.actions.act_window">
        <field name="name">Audit Log</field>
        <field name="res_model">pharmacy.audit.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pharmacy_audit_log_search"/>
    </record>
</odoo>
