<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_expiry_record_search" model="ir.ui.view">
        <field name="name">pharmacy.expiry.record.search</field>
        <field name="model">pharmacy.expiry.record</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="product_id"/>
                <field name="internal_reference"/>
                <field name="expiry_date"/>
                <field name="vendor_id"/>
                <field name="stock_picking_id"/>
                <filter name="expired" string="Expired" domain="[('expiry_status', '=', 'expired')]"/>
                <filter name="expiring_soon" string="Expiring Soon" domain="[('expiry_status', '=', 'expiring')]"/>
                <filter name="valid" string="Valid" domain="[('expiry_status', '=', 'valid')]"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_expiry" string="Expiry Month" context="{'group_by': 'expiry_date:month'}"/>
                    <filter name="group_vendor" string="Vendor" context="{'group_by': 'vendor_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pharmacy_expiry_record_list" model="ir.ui.view">
        <field name="name">pharmacy.expiry.record.list</field>
        <field name="model">pharmacy.expiry.record</field>
        <field name="arch" type="xml">
            <list string="Expiry Monitoring" decoration-danger="expiry_status == 'expired'" decoration-warning="expiry_status == 'expiring'" decoration-muted="not active">
                <field name="internal_reference"/>
                <field name="product_id"/>
                <field name="expiry_date"/>
                <field name="days_to_expiry"/>
                <field name="warning_days"/>
                <field name="expiry_status"/>
                <field name="received_quantity" optional="show"/>
                <field name="dispensed_quantity" optional="hide"/>
                <field name="available_quantity" optional="show"/>
                <field name="on_hand_qty" optional="show"/>
                <field name="stock_picking_id" optional="show"/>
                <field name="vendor_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_expiry_record_form" model="ir.ui.view">
        <field name="name">pharmacy.expiry.record.form</field>
        <field name="model">pharmacy.expiry.record</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Expiry Record">
                <sheet>
                    <widget name="web_ribbon" title="Expired" bg_color="text-bg-danger" invisible="expiry_status != 'expired'"/>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-secondary" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="product_id" readonly="stock_move_id"/>
                            <field name="internal_reference" readonly="1"/>
                            <field name="expiry_date" readonly="stock_move_id"/>
                            <field name="warning_days" readonly="1"/>
                            <field name="days_to_expiry" readonly="1"/>
                            <field name="expiry_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="received_quantity" readonly="stock_move_id"/>
                            <field name="product_uom_id" readonly="stock_move_id"/>
                            <field name="dispensed_quantity" readonly="1"/>
                            <field name="available_quantity" readonly="1"/>
                            <field name="on_hand_qty" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Receipt Source">
                        <group>
                            <field name="received_date"/>
                            <field name="vendor_id"/>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="purchase_line_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="stock_picking_id" readonly="1"/>
                            <field name="stock_move_id" readonly="1"/>
                            <field name="location_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_expiry_monitoring" model="ir.actions.act_window">
        <field name="name">Expiry Monitoring</field>
        <field name="res_model">pharmacy.expiry.record</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pharmacy_expiry_record_search"/>
        <field name="context">{'search_default_expiring_soon': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No medicines are approaching expiry</p>
            <p>Expiry records are created automatically when pharmacy medicines are received. Existing stock can be entered manually.</p>
        </field>
    </record>

    <record id="view_pharmacy_low_stock_search" model="ir.ui.view">
        <field name="name">product.template.pharmacy.low.stock.search</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="default_code"/>
                <filter name="attention" string="Needs Attention" domain="[('pharmacy_low_stock_status', 'in', ('negative', 'out', 'low'))]"/>
                <filter name="out" string="Out of Stock" domain="[('pharmacy_low_stock_status', 'in', ('negative', 'out'))]"/>
                <filter name="low" string="Low Stock" domain="[('pharmacy_low_stock_status', '=', 'low')]"/>
                <filter name="in_stock" string="In Stock" domain="[('pharmacy_low_stock_status', '=', 'in_stock')]"/>
                <group>
                    <filter name="group_category" string="Product Category" context="{'group_by': 'categ_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pharmacy_low_stock_list" model="ir.ui.view">
        <field name="name">product.template.pharmacy.low.stock.list</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <list string="Low Stock Monitoring" create="0" edit="0" decoration-danger="pharmacy_low_stock_status in ('negative', 'out')" decoration-warning="pharmacy_low_stock_status == 'low'">
                <field name="default_code" string="Internal Reference"/>
                <field name="name" string="Product"/>
                <field name="qty_available" string="On Hand"/>
                <field name="virtual_available" string="Forecasted"/>
                <field name="pharmacy_low_stock_threshold"/>
                <field name="pharmacy_low_stock_status"/>
            </list>
        </field>
    </record>

    <record id="action_pharmacy_low_stock_monitoring" model="ir.actions.act_window">
        <field name="name">Low Stock Monitoring</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_pharmacy_low_stock_list"/>
        <field name="search_view_id" ref="view_pharmacy_low_stock_search"/>
        <field name="domain">[('is_pharmacy_item', '=', True)]</field>
        <field name="context">{'search_default_attention': 1}</field>
    </record>

    <record id="view_purchase_order_form_pharmacy_expiry" model="ir.ui.view">
        <field name="name">purchase.order.form.pharmacy.expiry</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='date_planned']" position="after">
                <field name="pharmacy_expected_expiry_date" string="Expected Expiry" optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="view_stock_picking_form_pharmacy_expiry" model="ir.ui.view">
        <field name="name">stock.picking.form.pharmacy.expiry</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='move_ids']/list/field[@name='quantity']" position="after">
                <field name="pharmacy_expected_expiry_date" optional="hide" column_invisible="parent.picking_type_code != 'incoming'"/>
                <field name="pharmacy_actual_expiry_date" string="Actual Expiry" optional="show" column_invisible="parent.picking_type_code != 'incoming'"/>
            </xpath>
        </field>
    </record>
</odoo>
