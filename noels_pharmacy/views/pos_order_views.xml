<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_pos_form_pharmacy" model="ir.ui.view">
        <field name="name">pos.order.form.pharmacy</field>
        <field name="model">pos.order</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pharmacy_prescription" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not pharmacy_prescription_id">
                    <field name="pharmacy_prescription_id" widget="statinfo" string="Prescription"/>
                </button>
                <button name="action_view_pharmacy_dispensing" type="object" class="oe_stat_button" icon="fa-medkit" invisible="pharmacy_dispensing_count == 0">
                    <field name="pharmacy_dispensing_count" widget="statinfo" string="Dispensing"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="pharmacy_prescription_id" readonly="1" groups="noels_pharmacy.group_pharmacy_user"/>
            </xpath>
        </field>
    </record>
    <record id="view_pharmacy_dispensing_form_pos" model="ir.ui.view">
        <field name="name">pharmacy.dispensing.form.pos</field>
        <field name="model">pharmacy.dispensing</field>
        <field name="inherit_id" ref="noels_pharmacy.view_pharmacy_dispensing_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='source_reference']" position="after">
                <field name="pos_order_id" readonly="1" invisible="not pos_order_id"/>
            </xpath>
        </field>
    </record>
</odoo>
