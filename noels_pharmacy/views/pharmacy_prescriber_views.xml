<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_prescriber_list" model="ir.ui.view">
        <field name="name">pharmacy.prescriber.list</field>
        <field name="model">pharmacy.prescriber</field>
        <field name="arch" type="xml">
            <list string="Prescribers">
                <field name="name"/>
                <field name="license_number"/>
                <field name="specialty"/>
                <field name="partner_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_prescriber_form" model="ir.ui.view">
        <field name="name">pharmacy.prescriber.form</field>
        <field name="model">pharmacy.prescriber</field>
        <field name="arch" type="xml">
            <form string="Prescriber">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="partner_id"/>
                        <h1><field name="partner_id"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="license_number"/>
                            <field name="specialty"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="Prescriber verification notes..."/>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_prescriber" model="ir.actions.act_window">
        <field name="name">Prescribers</field>
        <field name="res_model">pharmacy.prescriber</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

