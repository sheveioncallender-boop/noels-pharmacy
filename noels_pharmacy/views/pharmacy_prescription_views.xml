<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_prescription_search" model="ir.ui.view">
        <field name="name">pharmacy.prescription.search</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="temporary_reference"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <field name="prescription_date"/>
                <field name="external_reference"/>
                <filter name="awaiting" string="Awaiting Review" domain="[('state', '=', 'awaiting_review')]"/>
                <filter name="open_balance" string="Refill / Balance Available" domain="[('state', '=', 'partially_dispensed')]"/>
                <filter name="dispensed" string="Dispensed" domain="[('state', '=', 'dispensed')]"/>
                <group>
                    <filter name="group_patient" string="Patient" context="{'group_by': 'patient_id'}"/>
                    <filter name="group_prescriber" string="Prescriber" context="{'group_by': 'prescriber_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="group_date" string="Prescription Date" context="{'group_by': 'prescription_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_pharmacy_prescription_list" model="ir.ui.view">
        <field name="name">pharmacy.prescription.list</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <list decoration-warning="state == 'awaiting_review'" decoration-success="state == 'dispensed'" decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="patient_id"/>
                <field name="prescriber_id"/>
                <field name="prescription_date"/>
                <field name="valid_until" optional="show"/>
                <field name="refills_allowed"/>
                <field name="approved_by_id" optional="show"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_pharmacy_prescription_form" model="ir.ui.view">
        <field name="name">pharmacy.prescription.form</field>
        <field name="model">pharmacy.prescription</field>
        <field name="arch" type="xml">
            <form string="Prescription">
                <header>
                    <button name="action_submit" type="object" string="Submit for Review" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" type="object" string="Approve" class="btn-primary" groups="noels_pharmacy.group_pharmacy_pharmacist" invisible="state != 'awaiting_review'"/>
                    <button name="action_prepare_for_pos" type="object" string="Prepare for POS" class="btn-primary" groups="noels_pharmacy.group_pharmacy_pharmacist" invisible="state not in ('approved', 'partially_dispensed')"/>
                    <button name="action_reset_to_draft" type="object" string="Return to Draft" groups="noels_pharmacy.group_pharmacy_pharmacist" invisible="state not in ('awaiting_review', 'approved')"/>
                    <button name="action_print_labels" type="object" string="Reprint Latest Labels" groups="noels_pharmacy.group_pharmacy_pharmacist" invisible="state in ('draft', 'awaiting_review', 'cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state in ('dispensed', 'cancelled')" confirm="The prescription number and audit history will remain visible. Continue?"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,awaiting_review,approved,partially_dispensed,dispensed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_dispensing" class="oe_stat_button" icon="fa-medkit">
                            <field name="dispensing_count" widget="statinfo" string="Dispensing"/>
                        </button>
                        <button type="object" name="action_view_alerts" class="oe_stat_button" icon="fa-exclamation-triangle">
                            <field name="alert_count" widget="statinfo" string="Alerts"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <label for="name" string="Prescription"/>
                        <h1><field name="name" readonly="1"/></h1>
                        <span class="text-muted">Original: <field name="temporary_reference" readonly="1" class="oe_inline"/></span>
                    </div>
                    <group>
                        <group>
                            <field name="patient_id" readonly="state != 'draft'"/>
                            <field name="purchaser_partner_id" readonly="state != 'draft'"/>
                            <field name="prescriber_id" readonly="state != 'draft'"/>
                            <field name="external_reference" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="prescription_date" readonly="state != 'draft'"/>
                            <field name="valid_until" readonly="state != 'draft'"/>
                            <field name="source_type" readonly="state != 'draft'"/>
                            <field name="refills_allowed" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <field name="diagnosis_notes" readonly="state != 'draft'" placeholder="Diagnosis or prescription notes..."/>
                    <notebook>
                        <page string="Medicines" name="medicines">
                            <field name="line_ids" readonly="state != 'draft'" context="{'default_prescription_id': id}">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="product_id"/>
                                    <field name="substituted_product_id" optional="hide"/>
                                    <field name="substitution_reason" optional="hide"/>
                                    <field name="prescribed_qty"/>
                                    <field name="product_uom_id"/>
                                    <field name="authorized_qty" readonly="1"/>
                                    <field name="qty_dispensed" readonly="1"/>
                                    <field name="remaining_qty" readonly="1"/>
                                    <field name="dose" optional="show"/>
                                    <field name="route" optional="show"/>
                                    <field name="frequency" optional="show"/>
                                    <field name="duration" optional="show"/>
                                    <field name="dispensing_instructions"/>
                                    <field name="directions_pending" optional="show"/>
                                    <field name="caution_instructions" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Prescription Document" name="documents">
                            <field name="attachment_ids" widget="many2many_binary" readonly="state == 'cancelled'"/>
                        </page>
                        <page string="Clinical Alerts" name="alerts">
                            <field name="clinical_alert_ids" readonly="1">
                                <list decoration-danger="severity == 'blocking' and status == 'open'" decoration-warning="severity == 'warning' and status == 'open'" decoration-muted="status == 'superseded'">
                                    <field name="alert_type"/>
                                    <field name="severity"/>
                                    <field name="title"/>
                                    <field name="status"/>
                                    <field name="overridden_by_id" optional="show"/>
                                    <field name="overridden_at" optional="hide"/>
                                </list>
                            </field>
                        </page>
                        <page string="Approval &amp; Cancellation" name="approval">
                            <group>
                                <group>
                                    <field name="approved_by_id" readonly="1"/>
                                    <field name="approved_at" readonly="1"/>
                                </group>
                                <group>
                                    <field name="cancellation_reason" readonly="state == 'cancelled'" placeholder="Required before cancellation..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_prescription" model="ir.actions.act_window">
        <field name="name">Prescriptions</field>
        <field name="res_model">pharmacy.prescription</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_pharmacy_prescription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Capture the first prescription</p>
            <p>Capture and approve the prescription here, then prepare and print its POS checkout labels.</p>
        </field>
    </record>
</odoo>
