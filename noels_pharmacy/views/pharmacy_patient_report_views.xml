<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pharmacy_patient_form_report" model="ir.ui.view">
        <field name="name">pharmacy.patient.form.report</field>
        <field name="model">pharmacy.patient</field>
        <field name="inherit_id" ref="noels_pharmacy.view_pharmacy_patient_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button type="object" name="action_print_pharmacy_history" class="oe_stat_button" icon="fa-print" groups="noels_pharmacy.group_pharmacy_pharmacist">
                    <div class="o_stat_info"><span class="o_stat_text">Print History</span></div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
