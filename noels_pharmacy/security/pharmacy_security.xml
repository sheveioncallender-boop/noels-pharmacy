<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_noels_pharmacy" model="ir.module.category">
        <field name="name">Noel's Pharmacy</field>
        <field name="description">Pharmacy dispensing and clinical records</field>
        <field name="sequence">35</field>
    </record>

    <record id="privilege_pharmacy_operations" model="res.groups.privilege">
        <field name="name">Pharmacy Operations</field>
        <field name="category_id" ref="module_category_noels_pharmacy"/>
        <field name="sequence">10</field>
    </record>

    <record id="privilege_pharmacy_audit" model="res.groups.privilege">
        <field name="name">Pharmacy Audit</field>
        <field name="category_id" ref="module_category_noels_pharmacy"/>
        <field name="sequence">20</field>
    </record>

    <record id="group_pharmacy_user" model="res.groups">
        <field name="name">Pharmacy User</field>
        <field name="privilege_id" ref="privilege_pharmacy_operations"/>
    </record>

    <record id="group_pharmacy_pharmacist" model="res.groups">
        <field name="name">Pharmacist</field>
        <field name="privilege_id" ref="privilege_pharmacy_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_pharmacy_user'))]"/>
    </record>

    <record id="group_pharmacy_manager" model="res.groups">
        <field name="name">Pharmacy Manager</field>
        <field name="privilege_id" ref="privilege_pharmacy_operations"/>
        <field name="implied_ids" eval="[(4, ref('group_pharmacy_pharmacist'))]"/>
    </record>

    <!-- System administrators must always have full access to the Pharmacy app. -->
    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_pharmacy_manager'))]"/>
    </record>

    <record id="group_pharmacy_auditor" model="res.groups">
        <field name="name">Pharmacy Auditor</field>
        <field name="privilege_id" ref="privilege_pharmacy_audit"/>
    </record>

    <record id="rule_pharmacy_patient_company" model="ir.rule">
        <field name="name">Pharmacy patients by company</field>
        <field name="model_id" ref="model_pharmacy_patient"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_register_type_company" model="ir.rule">
        <field name="name">Pharmacy register types by company</field>
        <field name="model_id" ref="model_pharmacy_register_type"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_patient_allergy_company" model="ir.rule">
        <field name="name">Patient allergies by company</field>
        <field name="model_id" ref="model_pharmacy_patient_allergy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_prescriber_company" model="ir.rule">
        <field name="name">Prescribers by company</field>
        <field name="model_id" ref="model_pharmacy_prescriber"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_staff_company" model="ir.rule">
        <field name="name">Pharmacy staff by company</field>
        <field name="model_id" ref="model_pharmacy_staff_profile"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_prescription_company" model="ir.rule">
        <field name="name">Prescriptions by company</field>
        <field name="model_id" ref="model_pharmacy_prescription"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_prescription_line_company" model="ir.rule">
        <field name="name">Prescription lines by company</field>
        <field name="model_id" ref="model_pharmacy_prescription_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_dispensing_company" model="ir.rule">
        <field name="name">Dispensing by company</field>
        <field name="model_id" ref="model_pharmacy_dispensing"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_dispensing_line_company" model="ir.rule">
        <field name="name">Dispensing lines by company</field>
        <field name="model_id" ref="model_pharmacy_dispensing_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_alert_company" model="ir.rule">
        <field name="name">Clinical alerts by company</field>
        <field name="model_id" ref="model_pharmacy_clinical_alert"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_register_entry_company" model="ir.rule">
        <field name="name">Register entries by company</field>
        <field name="model_id" ref="model_pharmacy_register_entry"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_user')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>

    <record id="rule_pharmacy_audit_company" model="ir.rule">
        <field name="name">Audit logs by company</field>
        <field name="model_id" ref="model_pharmacy_audit_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_pharmacy_manager')), (4, ref('group_pharmacy_auditor'))]"/>
    </record>
</odoo>
