<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pharmacy_label" model="report.paperformat">
        <field name="name">Noel's Pharmacy Medication Label</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_height">50</field>
        <field name="page_width">100</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">3</field>
        <field name="margin_bottom">3</field>
        <field name="margin_left">3</field>
        <field name="margin_right">3</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_report_pharmacy_label" model="ir.actions.report">
        <field name="name">Medication Labels</field>
        <field name="model">pharmacy.prescription.line</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">noels_pharmacy.report_pharmacy_medication_label</field>
        <field name="report_file">noels_pharmacy.report_pharmacy_medication_label</field>
        <field name="paperformat_id" ref="paperformat_pharmacy_label"/>
        <field name="print_report_name">'Medication Labels - %s' % (object.prescription_id.name)</field>
        <field name="binding_model_id" ref="model_pharmacy_prescription_line"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pharmacy_medication_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="line">
                <t t-set="latest_supply" t-value="line.dispensing_line_ids.filtered('dispensing_id').filtered(lambda item: item.dispensing_id.state == 'confirmed').sorted('id')[-1:]"/>
                <div class="page" style="font-family: Arial, sans-serif; font-size: 12px; line-height: 1.25;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 1px solid #000; padding-bottom: 3px; margin-bottom: 4px;">
                        <div>
                            <img src="/noels_pharmacy/static/description/logo.png" alt="Noel's Pharmacy" style="height: 24px; max-width: 235px; object-fit: contain; object-position: left;"/>
                        </div>
                        <div style="text-align: right;">
                            <strong t-esc="line.prescription_id.name"/><br/>
                            <span t-field="line.prescription_id.prescription_date"/>
                        </div>
                    </div>
                    <div style="font-size: 14px; margin-bottom: 3px;"><strong t-esc="line.prescription_id.patient_id.name.upper()"/></div>
                    <div><strong t-esc="(line.substituted_product_id or line.product_id).display_name"/> · Qty <span t-esc="latest_supply.quantity if latest_supply else line.prescribed_qty"/></div>
                    <div style="font-size: 14px; font-weight: bold; margin: 4px 0;" t-esc="line.dispensing_instructions"/>
                    <div t-if="line.caution_instructions"><strong>Caution:</strong> <span t-esc="line.caution_instructions"/></div>
                    <div style="margin-top: 4px; display: flex; justify-content: space-between;">
                        <span t-if="line.prescription_id.prescriber_id">Prescriber: <span t-esc="line.prescription_id.prescriber_id.name"/></span>
                        <span t-if="latest_supply">Pharmacist: <span t-esc="latest_supply.dispensing_id.pharmacist_initials"/></span>
                        <span t-elif="line.prescription_id.approved_by_id">Pharmacist: <span t-esc="line.prescription_id.approved_by_id.initials"/></span>
                    </div>
                    <div style="margin-top: 3px; font-size: 10px;">Keep out of reach of children. Use only as directed.</div>
                </div>
            </t>
        </t>
    </template>
</odoo>
