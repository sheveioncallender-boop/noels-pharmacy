<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_inspection_pack" model="ir.actions.report">
        <field name="name">Pharmacy Inspection Pack</field>
        <field name="model">pharmacy.inspection.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">noels_pharmacy.report_inspection_pack</field>
        <field name="report_file">noels_pharmacy.report_inspection_pack</field>
        <field name="print_report_name">'Noels Pharmacy Inspection %s to %s' % (object.date_from, object.date_to)</field>
        <field name="groups_id" eval="[(4, ref('noels_pharmacy.group_pharmacy_manager')), (4, ref('noels_pharmacy.group_pharmacy_auditor'))]"/>
    </record>
    <template id="report_inspection_pack">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="wizard">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h1 style="color:#0f4f9b;">Pharmacy Inspection &amp; Audit Pack</h1>
                        <h3>Noel's Pharmacy &amp; Wellness Center Ltd</h3>
                        <table class="table table-sm mt-4"><tr><th>Company</th><td t-field="wizard.company_id"/></tr><tr><th>Period</th><td><span t-field="wizard.date_from"/> to <span t-field="wizard.date_to"/></td></tr><tr><th>Generated</th><td><span t-esc="time.strftime('%d/%m/%Y %H:%M')"/></td></tr><tr><th>Generated By</th><td t-esc="user.name"/></tr></table>
                        <h2 class="mt-4">Prescription Register</h2>
                        <table class="table table-sm table-bordered"><thead><tr><th>RX</th><th>Date</th><th>Patient</th><th>DOB</th><th>Doctor</th><th>Refills</th><th>Status</th></tr></thead><tbody><tr t-foreach="wizard._prescriptions()" t-as="rx"><td t-field="rx.name"/><td t-field="rx.prescription_date"/><td t-field="rx.patient_id.name"/><td t-field="rx.patient_id.date_of_birth"/><td t-field="rx.prescriber_id.name"/><td t-field="rx.refills_allowed"/><td t-field="rx.state"/></tr></tbody></table>
                    </div>
                    <div class="page">
                        <h2 style="color:#0f4f9b;">Dispensing Log</h2>
                        <table class="table table-sm table-bordered"><thead><tr><th>Date</th><th>RX</th><th>Patient</th><th>Medicine</th><th>Qty</th><th>Remaining</th><th>Pharmacist</th><th>Lot</th></tr></thead><tbody><tr t-foreach="wizard._dispensing_lines()" t-as="line"><td t-field="line.dispensing_id.dispensed_at"/><td t-field="line.dispensing_id.prescription_id.name"/><td t-field="line.dispensing_id.patient_id.name"/><td t-field="line.product_id"/><td><span t-field="line.quantity"/> <span t-field="line.product_uom_id"/></td><td t-field="line.remaining_after"/><td t-field="line.dispensing_id.pharmacist_initials"/><td t-field="line.lot_id.name"/></tr></tbody></table>
                    </div>
                    <div class="page" t-foreach="wizard._register_types()" t-as="register_type">
                        <h2 style="color:#0f4f9b;"><span t-field="register_type.name"/> Register</h2>
                        <table class="table table-sm table-bordered"><thead><tr><th>Date</th><th>Movement</th><th>RX</th><th>Patient</th><th>Doctor</th><th>Medicine</th><th>Lot</th><th>In</th><th>Out</th><th>Pharmacist</th></tr></thead><tbody><tr t-foreach="wizard._register_entries(register_type)" t-as="entry"><td t-field="entry.entry_datetime"/><td t-field="entry.movement_type"/><td t-field="entry.prescription_id.name"/><td t-field="entry.patient_id.name"/><td t-field="entry.prescriber_id.name"/><td t-field="entry.product_id"/><td t-field="entry.lot_id.name"/><td t-field="entry.quantity_in"/><td t-field="entry.quantity_out"/><td t-field="entry.pharmacist_id.initials"/></tr></tbody></table>
                    </div>
                    <div class="page">
                        <h2 style="color:#0f4f9b;">Audit Events</h2>
                        <table class="table table-sm table-bordered"><thead><tr><th>Date</th><th>User</th><th>Action</th><th>Model</th><th>Record</th><th>Before / After</th></tr></thead><tbody><tr t-foreach="wizard._audit_events()" t-as="event"><td t-field="event.event_datetime"/><td t-field="event.user_id"/><td t-field="event.action"/><td t-field="event.model_name"/><td t-field="event.record_name"/><td style="font-size:8px;"><div t-if="event.old_values_text"><strong>Before:</strong> <span t-esc="event.old_values_text"/></div><div t-if="event.new_values_text"><strong>After:</strong> <span t-esc="event.new_values_text"/></div></td></tr></tbody></table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
