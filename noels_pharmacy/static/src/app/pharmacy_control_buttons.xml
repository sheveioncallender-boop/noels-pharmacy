<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-if="currentOrder?.uiState?.pharmacyPrescription?.exists" t-att-class="buttonClass" disabled="disabled">
                <i class="fa fa-medkit me-2" role="img" aria-label="Prepared prescription"/>
                <t t-esc="pharmacyPrescriptionLabel"/>
            </button>
        </xpath>
    </t>
</templates>
