<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('control-buttons-modal')]" position="inside">
            <button t-att-class="buttonClass" t-on-click="() => this.clickPharmacyPrescription()"><i class="fa fa-file-text-o me-2" role="img" aria-label="Prescription"/><t t-esc="pharmacyPrescriptionLabel"/></button>
        </xpath>
    </t>
    <t t-inherit="point_of_sale.ReceiptScreen" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('receipt-options')]/div[1]" position="after">
            <button t-if="hasPharmacyMedicine" class="button print btn btn-lg btn-outline-primary w-100 py-3" t-on-click="() => this.printPharmacyLabels()">
                <i class="fa fa-tags me-1"/>Print Medication Labels
            </button>
        </xpath>
    </t>
</templates>
