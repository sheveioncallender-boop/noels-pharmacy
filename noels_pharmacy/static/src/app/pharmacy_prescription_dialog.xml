<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="noels_pharmacy.PharmacyPrescriptionDialog">
        <Dialog title.translate="Prescription" size="xl" bodyClass="o_noels_rx_dialog">
            <div class="o_noels_rx_brand d-flex align-items-center gap-3 mb-3">
                <span class="o_noels_rx_mark">NP</span>
                <div><div class="fw-bold">Noel's Pharmacy &amp; Wellness Center Ltd</div><small>Prescription capture</small></div>
            </div>
            <div class="row g-3">
                <div class="col-12 col-lg-6"><label class="form-label">Patient</label><input class="form-control" t-model="state.patientName" t-att-readonly="state.patientIsCustomer ? true : undefined" placeholder="Existing customer or walk-in patient"/><div t-if="props.partnerId" class="form-check mt-1"><input id="noels-patient-customer" type="checkbox" class="form-check-input" t-att-checked="state.patientIsCustomer" t-on-change="onPatientCustomerChange"/><label for="noels-patient-customer" class="form-check-label small">Patient is the selected customer</label></div><small t-else="" class="text-muted">Walk-in / new patient</small></div>
                <div class="col-6 col-lg-3"><label class="form-label">Date of Birth</label><input type="date" class="form-control" t-model="state.dateOfBirth"/></div>
                <div class="col-6 col-lg-3"><label class="form-label">Prescription Date</label><input type="date" class="form-control" t-model="state.prescriptionDate"/></div>
                <div class="col-6 col-lg-3"><label class="form-label">Allergy Status</label><select class="form-select" t-model="state.allergyStatus"><option value="unknown">Not Confirmed</option><option value="none">No Known Drug Allergies</option><option value="known">Known Allergies</option></select></div>
                <div class="col-6 col-lg-3"><label class="form-label">Allergy</label><input class="form-control" t-model="state.allergyName" t-att-disabled="state.allergyStatus !== 'known'" placeholder="Allergen / reaction"/></div>
                <div class="col-12 col-lg-6"><label class="form-label">Doctor / Prescriber</label><input class="form-control" t-model="state.doctorName" placeholder="Dr. name"/></div>
                <div class="col-6 col-lg-3"><label class="form-label">Licence No.</label><input class="form-control" t-model="state.doctorLicense" placeholder="Optional"/></div>
                <div class="col-6 col-lg-3"><label class="form-label">Pharmacist Initials</label><input class="form-control text-uppercase" maxlength="10" t-model="state.pharmacistInitials" placeholder="e.g. SC"/></div>
                <div class="col-12 col-lg-8"><label class="form-label">Diagnosis / Notes</label><textarea class="form-control" rows="2" t-model="state.diagnosisNotes"/></div>
                <div class="col-6 col-lg-2"><label class="form-label">Refills Allowed</label><input type="number" min="0" step="1" class="form-control" t-model="state.refillsAllowed"/></div>
                <div class="col-6 col-lg-2"><label class="form-label">Source</label><select class="form-select" t-model="state.sourceType"><option value="physical">Physical</option><option value="whatsapp">WhatsApp</option><option value="email">Email PDF</option><option value="printed">Printed</option><option value="other">Other</option></select></div>
            </div>
            <div class="table-responsive mt-4">
                <table class="table table-sm align-middle"><thead><tr><th>Medicine</th><th class="text-end">Qty</th><th>Dispensing Instructions</th></tr></thead><tbody>
                    <tr t-foreach="state.lines" t-as="line" t-key="line.product_id"><td><t t-esc="line.name"/></td><td class="text-end"><t t-esc="line.quantity"/></td><td><input class="form-control" t-model="line.directions" placeholder="Take one tablet once daily..."/></td></tr>
                </tbody></table>
            </div>
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-8"><label class="form-label">Upload Prescription (image or PDF, max 10 MB)</label><input type="file" class="form-control" accept="image/*,application/pdf" t-on-change="onFileChange"/><small t-if="state.attachmentName" class="text-success" t-esc="state.attachmentName"/></div>
                <div class="col-12 col-lg-4 form-check mb-2"><input id="noels-rx-approve" type="checkbox" class="form-check-input" t-model="state.approveNow"/><label for="noels-rx-approve" class="form-check-label">Approve now (logged-in pharmacist only)</label></div>
            </div>
            <t t-set-slot="footer"><button class="btn btn-secondary" t-on-click="props.close" t-att-disabled="state.saving">Cancel</button><button class="btn btn-primary" t-on-click="save" t-att-disabled="state.saving"><i t-if="state.saving" class="fa fa-spinner fa-spin me-2"/>Save Prescription</button></t>
        </Dialog>
    </t>
</templates>
