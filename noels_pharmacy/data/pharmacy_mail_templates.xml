<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="mail_template_partial_fill_notification" model="mail.template">
        <field name="name">Pharmacy: Partial Prescription Follow-up</field>
        <field name="model_id" ref="model_pharmacy_prescription"/>
        <field name="subject">Prescription {{ object.name }} balance follow-up</field>
        <field name="email_from">{{ object.company_id.partner_id.email_formatted or user.email_formatted }}</field>
        <field name="email_to">{{ object.patient_email }}</field>
        <field name="description">Patient notification for an outstanding partially filled prescription.</field>
        <field name="body_html" type="html">
            <div style="font-family: Arial, sans-serif; font-size: 14px;">
                <p>Hello <t t-out="object.patient_id.name"/>,</p>
                <p>Noel's Pharmacy is following up on the remaining balance for prescription <strong><t t-out="object.name"/></strong>.</p>
                <p><strong>Outstanding medicine(s):</strong> <t t-out="object.outstanding_medicines"/></p>
                <p>Please contact the pharmacy before visiting so our team can confirm availability.</p>
                <p>Thank you,<br/><t t-out="object.company_id.name"/></p>
            </div>
        </field>
        <field name="auto_delete" eval="False"/>
    </record>
</odoo>
