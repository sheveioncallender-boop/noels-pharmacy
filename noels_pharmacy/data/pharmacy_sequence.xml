<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_pharmacy_prescription_temp" model="ir.sequence">
        <field name="name">Pharmacy Temporary Prescription</field>
        <field name="code">noels.pharmacy.prescription.temp</field>
        <field name="prefix">TMP-</field>
        <field name="padding">6</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_pharmacy_prescription" model="ir.sequence">
        <field name="name">Pharmacy Prescription</field>
        <field name="code">noels.pharmacy.prescription</field>
        <field name="prefix">RX</field>
        <field name="padding">6</field>
        <field name="implementation">no_gap</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_pharmacy_dispensing" model="ir.sequence">
        <field name="name">Pharmacy Dispensing</field>
        <field name="code">noels.pharmacy.dispensing</field>
        <field name="prefix">DSP</field>
        <field name="padding">6</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_pharmacy_expiry" model="ir.sequence">
        <field name="name">Pharmacy Expiry Record</field>
        <field name="code">noels.pharmacy.expiry</field>
        <field name="prefix">EXP</field>
        <field name="padding">6</field>
        <field name="implementation">standard</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
